generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Account lifecycle. Lockout is NOT a status: it is `lockedUntil` plus
/// `failedLoginAttempts`, because a cooldown has an end time and a status
/// would have to be recomputed to expire.
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

/// Per-school rounding (`AGENTS.md` §2.5). Never a constant (`ADR-002`).
enum RoundingMode {
  HALF_UP
  HALF_EVEN
  HALF_DOWN
  UP
  DOWN
  CEILING
  FLOOR
}

/// `ADR-009`: expired, invalid-signature and schema-error are three
/// different administrative states with three different remedies, so they
/// must never collapse into one status or one error.
/// `GRACE` is `PLT-305`: the activation server is unreachable but the
/// countdown has not run out.
enum LicenseStatus {
  PENDING
  ACTIVE
  GRACE
  EXPIRED
  INVALID
  REVOKED
}

/// `PLT-501` levels. ERROR and CRITICAL are also written to `error_logs`.
enum LogSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRRITICAL
}

/// `AGENTS.md` §2.2. EMAIL is the default the router falls back to.
/// SMS and WHATSAPP are per-message billed, which is why `PLT-701`
/// requires per-recipient rate limiting and digesting for them.
enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

/// `PLT-701`: EMERGENCY bypasses digesting and batching.
enum NotificationUrgency {
  NORMAL
  EMERGENCY
}

/// `PLT-702` delivery-status tracking. PENDING covers digest-held sends.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

/// `ADR-015` malware scan is a port with a no-op adapter until the real
/// scanner ships, so `SKIPPED` is a legitimate value and not a bug:
/// the seam exists so no module assumes scanning is inline.
enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  FAILED
}

/// A person who can authenticate.
///
/// `D-4.1`: roles are a JOIN, not a single foreign key. `ERD:84` recorded
/// that "a teacher who is also a parent cannot be expressed" - and that is
/// not a cosmetic gap, because such a user could not log in as both at all.
/// The owner confirmed multi-role on 2026-09-30.
///
/// There is deliberately NO primary-role flag. A user with three roles holds
/// the UNION of their permissions, because `AGENTS.md` 2.3 makes the
/// permission the only thing that gates a route. A `isPrimary` column would
/// introduce a second source of truth for "what can this user do", and the
/// two would disagree the first time an admin reordered anything.
///
/// A user holds NO student/teacher/parent data here: `PLT-203` resolves
/// ownership through abstract ports, and the domains that would own those
/// relationships do not exist yet.
model User {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId                String                   @map("school_id")
  id                      String                   @id @default(uuid()) @db.Uuid
  /// NOT NULL, and unique per school. Nullable-unique is a trap:
  /// PostgreSQL treats NULLs as distinct, so `email String?` with a
  /// `@@unique` would constrain nothing and two accounts could collide.
  email                   String
  /// Second login identifier. NOT NULL for the same reason as `email`.
  username                String
  /// `ADR-007`: argon2id behind `IPasswordHasher`. Nullable because an
  /// INVITED user has no password yet and `PLT-104` OTP is milestone 2.
  /// Never returned in a response and never logged.
  passwordHash            String?                  @map("password_hash")
  /// `ADR-007` verify-and-rehash needs to know which algorithm a hash was
  /// written with, so a legacy bcrypt hash can be upgraded on login
  /// without a second column or a forced reset.
  passwordAlgorithm       String?                  @map("password_algorithm")
  /// `NFR` password-age policy reads this.
  passwordUpdatedAt       DateTime?                @map("password_updated_at")
  mustChangePassword      Boolean                  @default(false) @map("must_change_password")
  status                  UserStatus               @default(INVITED)
  /// `PLT-107`: SHA-256 of the one-time bootstrap token, and ONLY the
  /// hash. The token is an unauthenticated route to the administrator
  /// account, so a cleartext copy in a database dump would be the
  /// school's only administrator credential. Same rule, and same reason,
  /// as `RefreshToken.tokenHash` (`AGENTS.md` 2.13).
  ///
  /// Option (b) of two, decided in the story: two columns on the one
  /// `INVITED` row rather than a seventeenth model. The first
  /// administrator is singular, so a table holding exactly one row that is
  /// written once and consumed once is a generalisation with one instance.
  /// `PLT-104` promotes these two columns into a real table when invites
  /// become many.
  ///
  /// NULL after consumption, which is what makes the token single-use.
  /// NULL is also the state of every user who never had one, so this
  /// column alone cannot distinguish "never issued" from "already spent" —
  /// the repository reads `status`/`passwordHash` for that, and the
  /// distinction is a documented limitation of option (b), not an accident.
  setupTokenHash          String?                  @map("setup_token_hash")
  /// `PLT-107`: when the bootstrap token stops being valid. There is no
  /// separate consumed-at column — nulling the hash above IS the
  /// consumption, and a second timestamp is a second thing to get out of
  /// step with the first.
  ///
  /// The comparison is `expiresAt > now` against an `IClock` (`AGENTS.md`
  /// 2.4), so the expiry boundary is deterministic and testable rather than
  /// a function of when the query happened to run. A row carrying a hash
  /// with no expiry is treated as EXPIRED, because that is the fail-closed
  /// reading.
  setupTokenExpiresAt     DateTime?                @map("setup_token_expires_at")
  /// `PLT-101` lockout counter. Threshold and cooldown are settings.
  failedLoginAttempts     Int                      @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?                @map("locked_until")
  lastLoginAt             DateTime?                @map("last_login_at")
  /// Master Plan §5.3: per-user language preference, defaulting to the
  /// school's configured default. Nullable on purpose — a `DEFAULT 'en'`
  /// would hard-code English into every deployment (`AGENTS.md` §8).
  preferredLocale         String?                  @map("preferred_locale")
  /// Provider sign-in credentials. One user may hold several, one per provider.
  externalIdentities      ExternalIdentity[]       @relation("fk_external_identity_user")
  /// Multi-role per `D-4.1`. The join rows carry the grants.
  roles                   UserRole[]               @relation("fk_user_role")
  sessions                Session[]                @relation("fk_session_user")
  refreshTokens           RefreshToken[]           @relation("fk_refresh_token_user")
  schoolSettingsUpdates   SchoolSettings[]         @relation("fk_school_settings_updated_by")
  notificationPreferences NotificationPreference[] @relation("fk_notification_preference_user")
  notificationDeliveries  NotificationDelivery[]   @relation("fk_notification_delivery_user")
  storedFiles             StoredFile[]             @relation("fk_stored_file_uploaded_by")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  @@unique([schoolId, email])
  @@unique([schoolId, username])
  @@index([status])
  @@index([lockedUntil])
  @@map("users")
}

/// A named bundle of permissions. `ADR-012`: the code catalogue decides
/// which permissions EXIST; this table decides which roles HOLD them.
///
/// DEVIATION FROM THE CORPUS, flagged not silently applied: `PLT-201` says
/// `school_id nullable for system roles`. That is a multi-tenant artefact —
/// it describes a role belonging to no school, which cannot happen when one
/// database is one school (`ADR-003`), and a nullable column in a unique
/// constraint does not constrain. `school_id` is therefore NOT NULL here and
/// system roles are marked with `isSystemRole` instead.
model Role {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId     String           @map("school_id")
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  /// `ADR-012`: system roles are immutable — cannot be deleted or stripped
  /// of core permissions, enforced server-side, not by hiding UI.
  /// The highest role is an in-school administrator; there is no
  /// cross-tenant super admin (`ADR-003`).
  isSystemRole Boolean          @default(false) @map("is_system_role")
  users        UserRole[]       @relation("fk_role_user_role")
  permissions  RolePermission[] @relation("fk_role_permission_role")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([schoolId, name])
  @@index([isSystemRole])
  @@map("roles")
}

/// One `MODULE_ACTION` key from the code catalogue (`ADR-012`), synced to
/// this table on deploy. Populated by the sync, never by a school admin, and
/// never by hand-typed strings in a role definition.
model Permission {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId    String           @map("school_id")
  id          String           @id @default(uuid()) @db.Uuid
  /// `MODULE_ACTION`, e.g. `FINANCE_INVOICE_REVERSE`.
  key         String
  /// The owning module. A namespace, not a tenancy or a hierarchy.
  module      String
  action      String
  description String?
  roles       RolePermission[] @relation("fk_role_permission_permission")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([schoolId, key])
  @@index([module])
  @@map("permissions")
}

/// The grant. Composite key, so the same grant cannot be inserted twice.
model RolePermission {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId     String     @map("school_id")
  /// A role holding a permission that no longer exists is a sync-time error, not a silent orphan (`ADR-012`).
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation("fk_role_permission_role", fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation("fk_role_permission_permission", fields: [permissionId], references: [id], onDelete: Cascade)
  /// Who granted it is answered by `audit_records` (`PLT-402`), not by a nullable column here.
  grantedAt    DateTime   @default(now()) @map("granted_at")

  @@id([schoolId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Which roles a user holds (`D-4.1`, owner-confirmed 2026-09-30).
///
/// Replaces `User.roleId`, a single foreign key, which could not express
/// a teacher who is also a parent - the case `ERD:84` named.
///
/// NO primary flag and no validity window, both deliberate. Permissions UNION
/// across every row here, because `AGENTS.md` 2.3 makes the permission the
/// only thing that gates a route. A `isPrimary` or `expiresAt` column would
/// add a second source of truth for "what can this user do", and the two
/// would disagree the first time an admin changed either.
///
/// Grant and expiry are answered by `audit_records` (`PLT-402`), which is
/// append-only by construction.
model UserRole {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId  String   @map("school_id")
  /// Restrict, not Cascade: `onDelete: Cascade` here is harmless, but the inverse matters - see the model comment.
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("fk_user_role", fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict. Deleting a role that still has users must fail rather than silently strip a school of an administrator - the same reasoning as the old single-FK shape.
  roleId    String   @map("role_id") @db.Uuid
  role      Role     @relation("fk_role_user_role", fields: [roleId], references: [id], onDelete: Restrict)
  grantedAt DateTime @default(now()) @map("granted_at")

  @@id([schoolId, userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// A sign-in credential issued by someone OTHER than this system (`PLT-101`).
///
/// Owner decision 2026-09-30: Google first, more providers expected. So `provider`
/// is a COLUMN, not a table per provider - adding Microsoft or Apple later is one
/// row per provider, with no model, no foreign key and no migration.
///
/// THE LOOKUP KEY IS `providerSubject`, NEVER THE EMAIL ADDRESS. That is the whole
/// point. Google calls it `sub`, it never changes for a person, and two people may
/// share an address. Signing in by address would silently merge two families into
/// one account, which is the child-safety failure `AGENTS.md` 2.13 exists to prevent.
/// providerEmail is a snapshot for display and may go stale; it is not unique and
/// nothing may join or authenticate on it.
///
/// NO password and NO token is stored here. Google authenticates the person; EduFlow
/// then issues its own session, because `ADR-008` needs revocable server-side sessions
/// and a provider token is not one. This table answers only which provider account is
/// this local user, and is written only after the provider token is verified.
///
/// providerEmailVerified records what the provider claimed at the time of linking. It is
/// a snapshot, so it is never re-read as a current fact, and a Workspace tenant that
/// does not assert verification simply leaves it null.
model ExternalIdentity {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId              String   @map("school_id")
  id                    String   @id @default(uuid()) @db.Uuid
  /// e.g. `google`. Data, never a compile-time enum, so a new provider is configuration.
  provider              String   @map("provider")
  /// The immutable user id the provider issued (Google: `sub`). THE LOOKUP KEY.
  /// An address is not, and must never be - see the model comment.
  providerSubject       String   @map("provider_subject")
  /// Snapshot for display. Deliberately NOT unique: two unrelated people may share one.
  providerEmail         String?  @map("provider_email")
  /// What the provider claimed at link time. A snapshot, so never trusted as current.
  providerEmailVerified Boolean? @map("provider_email_verified")
  /// Cascade: an identity row is meaningless without its user.
  userId                String   @map("user_id") @db.Uuid
  user                  User     @relation("fk_external_identity_user", fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, provider, providerSubject])
  @@index([userId])
  @@map("external_identities")
}

/// One server-side record per login. `ADR-008`: stateless-only JWTs cannot
/// be revoked before expiry, and `PLT-103` requires a revoked session to be
/// invalid on the NEXT request, and a role change to force re-auth within
/// one request cycle. That is why this table exists at all.
model Session {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId      String         @map("school_id")
  id            String         @id @default(uuid()) @db.Uuid
  /// A session is a bearer credential exactly as much as a refresh token is, and
  /// it is hashed at rest for the same reason `refresh_tokens.token_hash` is.
  ///
  /// WITHOUT this column the only handle on a session is its `id`, so the value
  /// carried in the cookie would BE a primary key. That leaks table structure, and it
  /// turns any accidental logging of a session id - an error message, a support
  /// screenshot, a proxy log - into a credential disclosure.
  ///
  /// SHA-256 is the right primitive here, and deliberately not argon2id: this is a
  /// 256-bit random string with nothing to brute-force, while argon exists for
  /// low-entropy human passwords. `@unique` makes the lookup one indexed read.
  tokenHash     String         @unique @map("token_hash")
  userId        String         @map("user_id") @db.Uuid
  user          User           @relation("fk_session_user", fields: [userId], references: [id], onDelete: Cascade)
  /// `ADR-008`: device tracking, so an administrator can answer "who is logged in, from where".
  deviceLabel   String?        @map("device_label")
  ipAddress     String?        @map("ip_address")
  userAgent     String?        @map("user_agent")
  createdAt     DateTime       @default(now()) @map("created_at")
  lastActiveAt  DateTime       @default(now()) @map("last_active_at")
  expiresAt     DateTime       @map("expires_at")
  /// Set the moment revocation takes effect, so the guard is a comparison and not a cache invalidation.
  revokedAt     DateTime?      @map("revoked_at")
  revokedReason String?        @map("revoked_reason")
  refreshTokens RefreshToken[] @relation("fk_refresh_token_session")

  @@index([userId])
  @@index([expiresAt])
  @@index([lastActiveAt])
  @@map("sessions")
}

/// Opaque, single-use, rotating (`ADR-008`). `familyId` is the load-bearing
/// column: presenting an already-rotated token revokes the WHOLE family,
/// which turns silent theft into a detectable, recoverable event. Without
/// it, a stolen token is valid for its full lifetime and nobody notices.
model RefreshToken {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId          String    @map("school_id")
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  session           Session   @relation("fk_refresh_token_session", fields: [sessionId], references: [id], onDelete: Cascade)
  /// Denormalised from the session so revoking every token for a user is one indexed query.
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation("fk_refresh_token_user", fields: [userId], references: [id], onDelete: Cascade)
  /// Shared by every token issued from one login. The unit that reuse detection revokes.
  familyId          String    @map("family_id")
  /// A refresh token is a bearer credential, so it is hashed at rest and never logged (`AGENTS.md` §2.13).
  tokenHash         String    @map("token_hash")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  expiresAt         DateTime  @map("expires_at")
  /// Set on rotation. A usedAt that comes back is a replay — except for
  /// the concurrent-refresh race, which `ADR-008` calls out as a mandatory
  /// test: a mobile client retrying on a flaky network must not have its
  /// family revoked. Either both sides check the window, or the loser is
  /// detected another way. GAP — resolved in PLT-102, not here.
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")
  /// Points at the token that replaced this one. Deliberately NOT a Prisma
  /// relation: a rotation chain is a DAG, and declaring it one-to-one would
  /// force a @unique that describes a modelling artefact rather than a rule,
  /// and a many-to-one that would imply a token can be replaced twice. The
  /// successor is one indexed lookup by primary key, so navigation is not
  /// needed. Indexed below because revocation walks the family, not the chain.
  replacedByTokenId String?   @map("replaced_by_token_id")

  @@index([sessionId])
  @@index([userId])
  @@index([familyId])
  @@index([replacedByTokenId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// APPEND-ONLY (`AGENTS.md` §2.7). There is no updatedAt and no deletedAt
/// because a timestamp that changes is the first step towards an update
/// path. The repository exposes only create() and query();
/// `apps/api/prisma/hardening/audit-immutability.sql` revokes UPDATE and
/// DELETE from the application role, because a rule nothing enforces is a
/// suggestion.
///
/// No relation to `users`, deliberately. A foreign key would either block a
/// user deletion or cascade the audit row away, and both destroy evidence.
/// The actor is recorded by value.
model AuditRecord {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId      String   @map("school_id")
  id            String   @id @default(uuid()) @db.Uuid
  /// UTC in storage, rendered in the school timezone (`AGENTS.md` §8).
  occurredAt    DateTime @default(now()) @map("occurred_at")
  /// A snapshot, not a foreign key. See the model comment.
  actorId       String?  @map("actor_id")
  /// Also a snapshot: the role held at the time, which is what an auditor asks about — not the role the user has now.
  actorRole     String?  @map("actor_role")
  ipAddress     String?  @map("ip_address")
  deviceInfo    String?  @map("device_info")
  /// Joins this row to the request and to `error_logs` (`PLT-501`).
  correlationId String   @map("correlation_id")
  /// The `@Audited('<ACTION_KEY>')` argument.
  action        String
  module        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  beforeValue   Json?    @map("before_value")
  afterValue    Json?    @map("after_value")
  /// Mandatory for the high-sensitivity subset (`PLT-402`), rejected with
  /// 400 BEFORE the transaction opens. Also mandatory for manual journal
  /// entries (`AGENTS.md` §2.6).
  reason        String?

  @@index([occurredAt])
  @@index([module, action])
  @@index([actorId])
  @@index([correlationId])
  @@index([entityType, entityId])
  @@map("audit_records")
}

/// The database half of `AGENTS.md` §2.15: every ERROR and CRITICAL goes to
/// the rotating file log AND here. Without the DB half, a critical error
/// becomes unqueryable the moment rotation purges it, which is exactly what
/// `PLT-504` needs to survive.
///
/// No relation to `users`, for the same reason as `audit_records`: a log must
/// not fail a write because an account was deleted, and logs outlive the
/// retention window of any individual user.
model ErrorLog {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId      String      @map("school_id")
  id            String      @id @default(uuid()) @db.Uuid
  occurredAt    DateTime    @default(now()) @map("occurred_at")
  severity      LogSeverity
  correlationId String      @map("correlation_id")
  userId        String?     @map("user_id")
  module        String?
  httpMethod    String?     @map("http_method")
  route         String?
  /// Redacted before it gets here (`PLT-502`): passwords, tokens, card
  /// data, secret keys and biometric templates never reach this column.
  message       String
  errorClass    String?     @map("error_class")
  stackTrace    String?     @map("stack_trace")
  context       Json?

  @@index([occurredAt])
  @@index([severity, occurredAt])
  @@index([correlationId])
  @@index([userId])
  @@map("error_logs")
}

/// The single canonical home for school-specific values (`AGENTS.md` §2.14).
/// `PLT-602`: a setting change takes effect without a restart and every
/// module reads it through one shared service.
///
/// One row per school, and one school per database (`ADR-003`) — so the
/// `@@unique([schoolId])` is what a school-specific query keys on, not a
/// tenant partition.
///
/// No defaults on timezone, currency or locale. A `DEFAULT` here would be a
/// silent default, and `AGENTS.md` §11 requires start-up to fail naming what
/// is missing rather than assume.
model SchoolSettings {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId               String       @map("school_id")
  id                     String       @id @default(uuid()) @db.Uuid
  name                   String
  legalName              String?      @map("legal_name")
  /// Never hard-coded (`AGENTS.md` §8).
  timezone               String
  defaultLocale          String       @map("default_locale")
  /// `ADR-002`. Explicit on every money value; never a product-wide constant.
  currencyCode           String       @map("currency_code")
  /// `ADR-002`. 2 for most currencies, 0 or 3 elsewhere. Per school, not per code.
  minorUnitScale         Int          @map("minor_unit_scale")
  /// `ADR-002` / `AGENTS.md` §2.5. A per-school setting, so a jurisdiction that mandates a mode is a config change.
  roundingMode           RoundingMode @map("rounding_mode")
  /// Never hard-code a school's academic calendar (`AGENTS.md` §8).
  academicYearStartMonth Int          @map("academic_year_start_month")
  /// The long tail, grouped by category (General, Academic Defaults,
  /// Notifications, Branding) and read through typed accessors
  /// (`PLT-602`). Typed columns stay above for the values that finance
  /// and every other module depend on, so they can be constrained.
  settings               Json
  /// `D49`: which email domains may sign in to THIS school. A list, on the
  /// one settings row, never an environment variable - `ADR-003` means one
  /// deployment is one school, so a global default is wrong for every
  /// school but one.
  ///
  /// `Json?` rather than `String[]`, chosen for what the TYPE forces a
  /// reader to handle. A list column is typed non-nullable, so a null
  /// reaching the reader - from a raw migration, a non-Prisma writer, a
  /// later column rewrite - is typed as impossible and the fail-closed
  /// branch looks unnecessary. That branch IS the control, so the
  /// dangerous state is made representable instead. The cost: nothing in
  /// the database constrains the contents to strings, and
  /// `PrismaAllowedEmailDomainStore` is the only thing that can notice.
  ///
  /// No `@default`, deliberately. A default writes a value nobody typed
  /// and makes "locked out on purpose" indistinguishable from "never
  /// configured". Null is the honest state and also the safe one: null,
  /// `[]` and a list whose every entry is unusable all mean NOTHING is
  /// permitted, which is what `D49` requires and what
  /// `decideEmailDomain` reports as `allowlist-not-configured` so an
  /// operator can tell it from a mistyped domain.
  ///
  /// Read through `IAllowedEmailDomainStore`; matched by exact equality
  /// after normalisation, never by `endsWith`.
  allowedEmailDomains    Json?        @map("allowed_email_domains")
  updatedById            String?      @map("updated_by_id") @db.Uuid
  updatedBy              User?        @relation("fk_school_settings_updated_by", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  @@unique([schoolId])
  @@index([updatedById])
  @@map("school_settings")
}

/// Which modules this school has switched ON (`PLT-601`).
///
/// There is deliberately no `active` / `is_enabled` column. The resolved
/// state is licence entitlement AND this admin toggle, and storing the
/// result would create a second source of truth that disagrees with the
/// certificate the moment a licence is renewed. Compute it.
model ModuleRegistry {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId       String    @map("school_id")
  id             String    @id @default(uuid()) @db.Uuid
  /// Matches an `allowed_modules` entry in the signed certificate (Master Plan §4.2).
  moduleKey      String    @map("module_key")
  /// An i18n key, not the label. A literal here would be an untranslatable string (`AGENTS.md` §2.8).
  displayNameKey String    @map("display_name_key")
  adminEnabled   Boolean   @default(true) @map("admin_enabled")
  enabledAt      DateTime? @map("enabled_at")
  disabledAt     DateTime? @map("disabled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([schoolId, moduleKey])
  @@index([adminEnabled])
  @@map("module_registry")
}

/// The signed certificate, verified locally against the embedded public key
/// (`ADR-009`). The private signing key never enters this repository, tests
/// included — `ADR-010` puts activation on an external vendor service.
///
/// One row per school. A renewal replaces the certificate in place; the
/// history of activations is answered by `audit_records`, which is append-only
/// by construction.
model License {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId                String        @map("school_id")
  id                      String        @id @default(uuid()) @db.Uuid
  /// From the certificate payload (Master Plan §4.2).
  licenseId               String        @map("license_id")
  /// A string, NOT an enum, on purpose. `ADR-009` forbids hard-coding an
  /// edition name in a guard; an enum would put the same four names in a
  /// compile-time constant in the database and make a fifth edition a
  /// migration. Gating is by feature key from the certificate, never by
  /// edition name.
  edition                 String
  /// The serial is never stored in the clear, and never logged (`AGENTS.md` §2.13).
  serialKeyHash           String?       @map("serial_key_hash")
  /// The signed payload, schema-validated BEFORE the signature is checked (`ADR-009`), so a malformed certificate fails as a schema error rather than a signature error.
  certificate             Json
  signature               String
  /// Lets a rotated key overlap the old one without invalidating historical certificates.
  keyId                   String        @map("key_id")
  /// `ADR-009`: part of the signed material, so the canonicalisation can change later without invalidating issued certificates.
  canonicalizationVersion Int           @map("canonicalization_version")
  status                  LicenseStatus @default(PENDING)
  issuedAt                DateTime      @map("issued_at")
  activatedAt             DateTime?     @map("activated_at")
  expiresAt               DateTime      @map("expires_at")
  /// `PLT-301` caches the verification result; `PLT-305` runs the grace countdown from it.
  lastValidatedAt         DateTime?     @map("last_validated_at")
  /// `ADR-011`: a stable install id generated once and stored, NOT a MAC
  /// address. A container gets a new MAC on every restart, so a MAC-bound
  /// licence breaks on a routine infrastructure restart.
  installId               String?       @map("install_id")
  /// `ADR-011` secondary signal only. Never the sole binding — it is the part most likely to change.
  hostHash                String?       @map("host_hash")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@unique([schoolId])
  @@index([expiresAt])
  @@index([status])
  @@map("licenses")
}

/// Per-user channel resolution for `PLT-701`. The router falls back to EMAIL
/// (`AGENTS.md` §2.2); `isDefault` marks which channel wins for an event
/// type when a user has not overridden it.
///
/// Digesting exists because SMS and WhatsApp are per-message billed.
model NotificationPreference {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId        String                 @map("school_id")
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  user            User                   @relation("fk_notification_preference_user", fields: [userId], references: [id], onDelete: Cascade)
  eventType       String                 @map("event_type")
  channel         NotificationChannel
  enabled         Boolean                @default(true)
  isDefault       Boolean                @default(false) @map("is_default")
  /// Never applies to an EMERGENCY event — those bypass digesting (`PLT-701`).
  digestEnabled   Boolean                @default(false) @map("digest_enabled")
  deliveries      NotificationDelivery[] @relation("fk_notification_delivery_preference")
  /// 0-23 in the SCHOOL timezone, not UTC.
  digestHour      Int?                   @map("digest_hour")
  quietHoursStart Int?                   @map("quiet_hours_start")
  quietHoursEnd   Int?                   @map("quiet_hours_end")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@unique([schoolId, userId, eventType, channel])
  @@index([userId, eventType])
  @@map("notification_preferences")
}

/// One row per channel per recipient event (`PLT-702` status tracking).
///
/// There is NO money column, and that is deliberate. SMS and WhatsApp are
/// per-message billed, but the bill is a financial transaction and every
/// financial transaction posts through `ILedgerPostingRule`
/// (`AGENTS.md` §2.6). Putting a cost here would be a second, unbudgeted
/// place where money lives, in the school currency when the vendor bills in
/// its own — which is the FX question `ADR-002` puts out of scope.
model NotificationDelivery {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId                 String                     @map("school_id")
  id                       String                     @id @default(uuid()) @db.Uuid
  userId                   String                     @map("user_id") @db.Uuid
  user                     User                       @relation("fk_notification_delivery_user", fields: [userId], references: [id], onDelete: Cascade)
  /// Nullable: an EMERGENCY broadcast reaches a user who never configured a preference.
  notificationPreferenceId String?                    @map("notification_preference_id") @db.Uuid
  preference               NotificationPreference?    @relation("fk_notification_delivery_preference", fields: [notificationPreferenceId], references: [id], onDelete: SetNull)
  eventType                String                     @map("event_type")
  channel                  NotificationChannel
  urgency                  NotificationUrgency        @default(NORMAL)
  status                   NotificationDeliveryStatus @default(PENDING)
  subject                  String?
  /// A truncated preview for diagnostics, not the rendered body — a stored body becomes a stored copy of children's data (`AGENTS.md` §2.13).
  bodyPreview              String?                    @map("body_preview")
  /// Non-null means the row is held for a digest batch rather than being sent.
  digestKey                String?                    @map("digest_key")
  attempts                 Int                        @default(0)
  providerMessageId        String?                    @map("provider_message_id")
  lastAttemptAt            DateTime?                  @map("last_attempt_at")
  sentAt                   DateTime?                  @map("sent_at")
  deliveredAt              DateTime?                  @map("delivered_at")
  failedAt                 DateTime?                  @map("failed_at")
  failureReason            String?                    @map("failure_reason")
  correlationId            String                     @map("correlation_id")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([correlationId])
  @@index([digestKey])
  @@map("notification_deliveries")
}

/// Metadata for an object in S3-compatible storage (`ADR-015`). The bytes
/// are never in PostgreSQL — the Document/Print engine produces large PDFs
/// and videos, and `bytea` would bloat every backup.
///
/// No parent-entity reference. `ADR-015` says a file's access follows its
/// parent entity, and no such entity exists in Platform Core — `PLT-801`
/// builds `IFileAccessPolicy` against fakes precisely so this table is not
/// guessing at Student or Homework. GAP: the owning module adds its own
/// link when it ships.
model StoredFile {
  /// Which school this row belongs to. METADATA ONLY.
  /// One database per school (ADR-003), so no query is scoped by it and no guard
  /// reads it. There is no `School` table and no foreign key: isolation is
  /// physical. It exists for auditability and licence portability.
  schoolId         String         @map("school_id")
  id               String         @id @default(uuid()) @db.Uuid
  /// A tag such as `id-photo` or `homework-submission`, so retention and access rules apply per scope instead of per bucket (`ADR-015`).
  scope            String
  /// Recorded per object so a provider change does not require backfilling a constant.
  storageProvider  String         @map("storage_provider")
  /// Private bucket, always. Retrieval is by signed time-limited URL, never by public read (`ADR-015`).
  bucket           String
  objectKey        String         @map("object_key")
  originalFilename String         @map("original_filename")
  /// Validated by content sniffing, not by extension — a `.exe` renamed `.jpg` is the case that prevents (`PLT-802`).
  contentType      String         @map("content_type")
  /// Int, not BigInt: a deliberate 2 GB per-file ceiling, below which the
  /// per-scope max size in `PLT-802` already rejects. Not bytes of money —
  /// `ADR-002` does not apply, so this is not a monetary value.
  sizeBytes        Int            @map("size_bytes")
  checksum         String
  scanStatus       FileScanStatus @default(PENDING) @map("scan_status")
  scannedAt        DateTime?      @map("scanned_at")
  uploadedById     String?        @map("uploaded_by_id") @db.Uuid
  uploadedBy       User?          @relation("fk_stored_file_uploaded_by", fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Per scope, from the retention policy. Archival, not deletion (`PLT-404`).
  retentionUntil   DateTime?      @map("retention_until")
  purgedAt         DateTime?      @map("purged_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([schoolId, objectKey])
  @@index([scope])
  @@index([uploadedById])
  @@index([scanStatus])
  @@map("stored_files")
}

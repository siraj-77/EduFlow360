        "clsx": "^2.1.1",
        "next": "^15.1.3",
        "next-intl": "^3.26.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^2.5.5"
    },
    "devDependencies": {
        "@eduflow/config": "workspace:*",
        "@eslint/js": "^9.17.0",
        "@playwright/test": "^1.49.1",
        "@tailwindcss/postcss": "^4.0.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",

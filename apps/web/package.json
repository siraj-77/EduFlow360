{
    "name": "@eduflow/web",
    "version": "0.0.0",
    "private": true,
    "description": "EduFlow web. UI only â€” the API is a separate NestJS service (AGENTS.md 3.1). No server actions.",
    "type": "module",
    "scripts": {
        "dev": "next dev --port 3000",
        "build": "next build",
        "start": "next start --port 3000",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:integration": "echo \"no web integration suite at P2\" && exit 0",
        "test:e2e": "playwright test",
        "clean": "node -e \"const fs=require('node:fs');['dist','.next','coverage','test-results','playwright-report'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\""
    },

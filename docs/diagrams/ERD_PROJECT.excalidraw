      "type": "text",
      "x": 48,
      "y": 3462,
      "width": 1280,
      "height": 18,
      "text": "✕ no `School` table — one database per school makes it a second tenancy concept (ADR-003)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#161a23",
      "backgroundColor": "transparent",
      "id": "el_000058"
    },
    {
      "angle": 0,
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "fillStyle": "solid",

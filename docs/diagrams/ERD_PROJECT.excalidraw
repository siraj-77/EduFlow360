      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 48,
      "y": 3486,
      "width": 1280,
      "height": 18,
      "text": "✕ no cross-tenant aggregate query and no cross-tenant role; SUPER_ADMIN does not exist here",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#161a23",
      "backgroundColor": "transparent",
      "id": "el_000059"
    },
    {
      "angle": 0,
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

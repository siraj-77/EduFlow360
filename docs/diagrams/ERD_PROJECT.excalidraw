      "link": null,
      "locked": false,
      "type": "text",
      "x": 48,
      "y": 3510,
      "width": 1280,
      "height": 18,
      "text": "✕ audit_records is append-only, with no foreign key to users — the actor is recorded by value",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#161a23",
      "backgroundColor": "transparent",
      "id": "el_00005a"
    },

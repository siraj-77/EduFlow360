      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 720,
      "y": 3318,
      "width": 608,
      "height": 17,
      "text": "no feature module writes journal_entries directly. Every financial transaction posts through ILedgerPostingRule, and an entry whose debits and credits differ is rejected in the domain before it reaches the database.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#161a23",
      "backgroundColor": "transparent",
      "id": "el_000055"
    },

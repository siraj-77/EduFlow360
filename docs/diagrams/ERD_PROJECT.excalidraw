      "locked": false,
      "type": "text",
      "x": 48,
      "y": 3434,
      "width": 1280,
      "height": 20,
      "text": "What this diagram deliberately does not show",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#dc2626",
      "backgroundColor": "transparent",
      "id": "el_000057"
    },

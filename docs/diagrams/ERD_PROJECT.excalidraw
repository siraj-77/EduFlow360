      "x": 720,
      "y": 3294,
      "width": 608,
      "height": 21,
      "text": "The ledger has one door",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#4f46e5",
      "backgroundColor": "transparent",
      "id": "el_000054"
    },
    {
      "angle": 0,
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

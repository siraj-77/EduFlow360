      "locked": false,
      "type": "text",
      "x": 48,
      "y": 3534,
      "width": 1280,
      "height": 18,
      "text": "✕ no money column on notification_deliveries — a per-message bill posts through ILedgerPostingRule",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#161a23",
      "backgroundColor": "transparent",
      "id": "el_00005b"

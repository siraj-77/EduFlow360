      "locked": false,
      "type": "text",
      "x": 48,
      "y": 3318,
      "width": 608,
      "height": 17,
      "text": "attendance, stock, booking, approvals, documents, notifications and ledger are each built once and extended by implementing an interface (AGENTS.md §2.9).",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#161a23",
      "backgroundColor": "transparent",
      "id": "el_000052"
    },
    {

      "link": null,
      "locked": false,
      "type": "text",
      "x": 48,
      "y": 1226,
      "width": 1280,
      "height": 17,
      "text": "audit_records immutability is a database privilege and a trigger, not a convention (ADR-013, hardening SQL).",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",

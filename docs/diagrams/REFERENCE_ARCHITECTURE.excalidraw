      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 48,
      "y": 1186,
      "width": 1280,
      "height": 18,
      "text": "S3-compatible — object bytes · behind IStorageAdapter, private buckets only",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#161a23",
      "backgroundColor": "transparent",
      "id": "el_00001l"
    },
    {
      "angle": 0,
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

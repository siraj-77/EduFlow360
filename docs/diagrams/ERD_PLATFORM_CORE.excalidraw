      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "One PostgreSQL database per school · physical isolation · no tenant scoping · no cross-tenant role\nGenerated from apps/api/prisma/schema-source.mjs — the same source that generates schema.prisma\nEvery unique constraint is scoped by school_id. audit_records is append-only and has no foreign key to users.",
      "roughness": 1,
      "roundness": null,
      "seed": 915502953,
      "strokeColor": "#5b6270",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "One PostgreSQL database per school · physical isolation · no tenant scoping · no cross-tenant role\nGenerated from apps/api/prisma/schema-source.mjs — the same source that generates schema.prisma\nEvery unique constraint is scoped by school_id. audit_records is append-only and has no foreign key to users.",
      "textAlign": "left",
      "updated": 1790687067348,
      "version": 1,
      "versionNonce": 413089867,
      "verticalAlign": "top"
    },

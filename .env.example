# EduFlow360 — environment template. TRACKED. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit it. Never paste a real value into
# THIS file: AGENTS.md section 11 forbids real-looking example values in
# tracked files, so every value below is a greppable `localdev` marker —
# obviously fake, and safe to commit. The validator rejects a placeholder
# in the RUNTIME .env (env.ts PLACEHOLDER_PATTERN); this template ships
# none, so a straight copy boots.
#
# --- Required from P4 (persistence) -----------------------------------
# One database PER SCHOOL. EduFlow360 is single-tenant: there is no shared
# multi-tenant database and none should be configured (ADR-003).
DATABASE_URL="postgresql://eduflow_dev:localdev@localhost:5432/eduflow_dev"

# --- Required from P4 (queue + cache) ---------------------------------
# Redis has no official Windows build. See README "Running without Docker".
REDIS_URL="redis://localhost:6379"

# --- Object storage (ADR-015) ------------------------------------------
# MinIO locally; any S3-compatible provider per school in production.
# Private buckets only; retrieval is via signed, time-limited URLs.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="localdev-access-key"
STORAGE_SECRET_KEY="localdev-secret-key-not-a-real-secret"
STORAGE_BUCKET="eduflow"

# --- Tokens (ADR-008) --------------------------------------------------
# Generate each with:  openssl rand -base64 32
# Minimum 32 characters. Access and refresh MUST differ.
JWT_ACCESS_SECRET="localdev-only-not-a-real-secret-0000000000000000"
JWT_REFRESH_SECRET="localdev-only-not-a-real-secret-1111111111111111"

# --- Licensing (ADR-009, ADR-010) -------------------------------------
# PUBLIC key only. The private signing key never enters this repository,
# including its tests — test keypairs are generated at runtime.
LICENSE_PUBLIC_KEY_PATH="./keys/license.pub.pem"

# --- Google OIDC (PLT-101) ------------------------------------------------
# Authorization-code flow. Google is the FIRST provider; `provider` is a
# column and not a table per provider, so Microsoft or Apple later is a row
# and not a migration (owner decision 2026-09-30).
#
# ALL THREE OR NONE. A partial set is rejected at boot rather than failing
# later at the token exchange, where the error comes from Google and reads
# like a provider fault.
#
# Console: console.cloud.google.com -> Google Auth Platform -> Clients ->
# Create client -> Application type "Web application". The redirect URI must
# match the Authorized redirect URI byte for byte, and the port below is the
# API (env.ts), not the web app (3500).
# The credentials shown are the CLIENT secret. There is no refresh-token
# credential here: EduFlow360 issues its own session (ADR-008), and Google's
# token ends at that boundary.
#
# Do NOT install Auth.js. Both of its session strategies contradict ADR-008.
# The values below are localdev markers, not real credentials: a deployment
# enters the real ones from the Google console into the git-ignored .env.
GOOGLE_CLIENT_ID="localdev-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="localdev-client-secret-not-a-real-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/oidc/callback"

# --- OIDC sign-in state window ----------------------------------------
# How long a begun sign-in stays open, in milliseconds. Bounds the signed
# state bundle that GET /auth/oidc/redirect writes and GET /auth/oidc/callback
# reads. Must exceed Google's authorization-code lifetime, or a legitimate
# sign-in expires while the user is still authenticating.
# Must be a positive WHOLE number: anything else produces an Expires the
# browser discards, and a discarded Expires is a cookie with no expiry.
OIDC_STATE_TTL_MS=600000

# --- OIDC callback throttle ------------------------------------------
# The throttle on GET /auth/oidc/callback. Twenty callbacks per source
# per ten minutes, and there is no corpus source for either number.
# Recorded as a GAP alongside the setup throttle rather than presented
# as chosen (AGENTS.md 6): a missing requirement stays visible rather
# than being filled with a number that looks decided. Both are recorded
# gaps, no corpus source, matching env.ts.
OIDC_CALLBACK_MAX_ATTEMPTS=20
OIDC_CALLBACK_WINDOW_MS=600000

# --- Runtime ---------------------------------------------------------------
NODE_ENV="development"
PORT=3001
LOG_LEVEL="INFO"
LOG_DIR="logs"

# --- Which deployment this database belongs to ---------------------------
# EduFlow360 is single-tenant: ONE database per school (ADR-003). Every table
# still carries a schoolId column as metadata for auditability and licence
# portability, and this is the value in it. A UUID.
#
# NO DEFAULT, deliberately. A default would mean an operator who never set it
# silently inherits one. seed.mjs has its own documented local default; the API
# does not. Must match the schoolId the rows were written with, or every read
# and write in the credential routes matches nothing.
SCHOOL_ID="00000000-0000-4000-8000-000000000001"

# --- Credential-route thresholds ------------------------------------------
# AGENTS.md 2.14 puts every threshold in settings; 8 forbids hard-coding one.
# Provenance is not uniform, and env.ts says which number came from where:
#   LOGIN_MAX_FAILED_ATTEMPTS / LOGIN_LOCKOUT_MS -> stated by the corpus
#     (Prompt Pack PLT-101: "lockout at 5 fails/10 min -> 429")
#   everything below -> NO corpus source, recorded as gaps pending owner
#     sign-off. Do not treat these as reviewed values.
#
# Session and refresh lifetimes. REFRESH_TOKEN_TTL_MS must exceed
# SESSION_TTL_MS or every session becomes unrenewable. Whole milliseconds.
SESSION_TTL_MS=3600000
REFRESH_TOKEN_TTL_MS=1209600000

# Account lockout after repeated failures.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MS=600000

# Provisional password policy: LENGTH BOUNDS ONLY, no composition rules.
# There is no password policy in the requirements corpus - School Setup
# Workflow 6.2/452 defers it to Phase 4 - so this is the smallest thing that
# makes PLT-107's "a password failing the policy does not consume the token"
# testable at all. Replace it when Phase 4 designs the real policy.
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Throttle on POST /auth/setup/complete, per source address. That route is the
# only unauthenticated WRITE in the system, so this is the only thing between
# an attacker and the administrator account.
SETUP_MAX_ATTEMPTS=10
SETUP_ATTEMPT_WINDOW_MS=900000

# Origin allowed to call the API. The web app runs on 3500 (apps/web/web-port.ts).
WEB_ORIGIN="http://localhost:3500"

# --- Web ---------------------------------------------------------------
# The API's address, as the web app sees it. Absolute in local development
# (cross-origin, so the browser preflights and the CSRF header works as a
# channel test); root-relative ("/api") in production, where the API sits
# behind a reverse proxy on the same host. Read by
# apps/web/src/lib/api-base-url.ts as NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

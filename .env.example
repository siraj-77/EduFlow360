# EduFlow — environment template. TRACKED. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit it. Never paste a real value into
# THIS file: AGENTS.md section 11 forbids real-looking example values in
# tracked files, so every placeholder below is wrapped in angle brackets
# and the validator rejects one that is still a placeholder.
#
# --- Required from P4 (persistence) -----------------------------------
# One database PER SCHOOL. EduFlow is single-tenant: there is no shared
# multi-tenant database and none should be configured (ADR-003).
DATABASE_URL="<postgresql://eduflow_dev:<password>@localhost:5432/eduflow>"

# --- Required from P4 (queue + cache) ---------------------------------
# Redis has no official Windows build. See README "Running without Docker".
REDIS_URL="<redis://localhost:6379>"

# --- Object storage (ADR-015) ------------------------------------------
# MinIO locally; any S3-compatible provider per school in production.
# Private buckets only; retrieval is via signed, time-limited URLs.
STORAGE_ENDPOINT="<http://localhost:9000>"
STORAGE_ACCESS_KEY="<eduflow_dev>"
STORAGE_SECRET_KEY="<local_dev_only_not_a_secret>"
STORAGE_BUCKET="eduflow"

# --- Tokens (ADR-008) --------------------------------------------------
# Generate each with:  openssl rand -base64 32
# Minimum 32 characters. Access and refresh MUST differ.
JWT_ACCESS_SECRET="<generate with: openssl rand -base64 32>"
JWT_REFRESH_SECRET="<generate with: openssl rand -base64 32>"

# --- Licensing (ADR-009, ADR-010) -------------------------------------
# PUBLIC key only. The private signing key never enters this repository,
# including its tests — test keypairs are generated at runtime.
LICENSE_PUBLIC_KEY_PATH="<./keys/license.pub.pem>"

# --- Runtime -----------------------------------------------------------
NODE_ENV="development"
PORT=3001
LOG_LEVEL="INFO"
LOG_DIR="logs"

# Origin allowed to call the API. The web app runs on 3000.
WEB_ORIGIN="http://localhost:3000"

# --- Web ---------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"

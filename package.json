{
  "name": "eduflow",
  "version": "0.0.0",
  "private": true,
  "description": "EduFlow — single-tenant school ERP. One database and one deployment per school.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,cjs,json}\" \"packages/**/*.{ts,tsx,js,mjs,cjs,json}\" \"scripts/**/*.{mjs,js}\" \"*.{json,yml,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs,cjs,json}\" \"packages/**/*.{ts,tsx,js,mjs,cjs,json}\" \"scripts/**/*.{mjs,js}\" \"*.{yml,yaml}\"",
    "format:check:docs": "prettier --check \"docs/**/*.md\" \"*.md\"",
    "docs:verify": "node scripts/docs-verify.mjs",
    "check:route-guards": "node scripts/check-route-guards.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "migration:generate": "pnpm --filter @eduflow/api migration:generate",
    "migration:run": "pnpm --filter @eduflow/api migration:run"
  },
  "devDependencies": {
    "@eduflow/config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}

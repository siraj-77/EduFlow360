# ---- Secrets — never commit ----
# NOTE: a root `.env.local` currently exists in this repo from the legacy
# EduFlowV3 setup. It is dead config here (this app is single-tenant, one
# database per school, so a single shared DATABASE_URL is architecturally
# wrong for it). Do not migrate that file. Each per-school deployment carries
# its own environment, provisioned by `PLT-004`.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
!secrets/.gitkeep

# ---- Node ----
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-error.log*
bun.lockb
.eslintcache
node-linker

# ---- Build output ----
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
*.map

# ---- Test + coverage ----
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
detox/
e2e/artifacts/

# ---- Framework / tooling caches ----
.cache/
.parcel-cache/
.vite/
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*

# ---- Local data + logs ----
*.db
*.db-journal
*.sqlite
*.sqlite3
logs/
*.log
nul
dev.db

# ---- Generated clients ----
# Prisma client is generated at install time, never committed.
lib/generated/
**/generated/prisma/

# ---- Prisma migration-local scratch ----
prisma/*.db
prisma/*.db-journal

# ---- Editors + OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Temp / worktrees ----
.tmp/
.temp/
.todo/
*-backup/
*.orig
*.rej

# ---- Local agent configuration — MUST NEVER be committed ----
# `.claude/settings.json` contained a live `thk_live_` credential plus
# machine-specific model routing (a third-party `ANTHROPIC_BASE_URL`).
# It is local machine configuration, not project configuration, so it is
# excluded in full rather than committed as a sanitised template.
# Tracked instead: `.claude/settings.local.json` conventions are documented
# in `docs/core/SSOT.md` section 4 and the Prompt Pack section 1.3.
.claude/

# ---- Optional tooling output referenced by AGENTS.md section 10 ----
graphify-out/
.graphify_*.json
